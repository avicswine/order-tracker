generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Carrier {
  id                 String         @id @default(cuid())
  name               String
  cnpj               String         @unique
  phone              String
  active             Boolean        @default(true)
  trackingSystem     TrackingSystem @default(NONE)
  trackingIdentifier String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  orders             Order[]

  @@map("carriers")
}

model Order {
  id                String        @id @default(cuid())
  orderNumber       String        @unique
  customerName      String
  customerEmail     String?
  customerPhone     String?
  carrierId         String?
  carrier           Carrier?      @relation(fields: [carrierId], references: [id])
  status            OrderStatus   @default(PENDING)
  shippedAt         DateTime?
  estimatedDelivery DateTime?
  deliveredAt       DateTime?
  notes             String?
  nfNumber          String?
  nfValue           Float?
  nfIssuedAt        DateTime?
  senderCnpj        String?
  recipientCnpj     String?
  lastTracking      String?
  lastTrackingAt    DateTime?
  trackingEvents    Json?
  hasOccurrence     Boolean   @default(false)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  statusHistory     StatusHistory[]
  notifications     OrderNotification[]

  @@index([status])
  @@index([nfNumber])
  @@index([estimatedDelivery, status])
  @@map("orders")
}

model StatusHistory {
  id        String      @id @default(cuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    OrderStatus
  note      String?
  createdAt DateTime    @default(now())

  @@map("status_history")
}

model BlingToken {
  id           String   @id @default(cuid())
  companyKey   String   @unique
  accessToken  String
  refreshToken String
  updatedAt    DateTime @updatedAt

  @@map("bling_tokens")
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      UserRole @default(VIEWER)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model WhatsappSession {
  id        String   @id @default(cuid())
  company   String   @unique   // "avic" | "agro"
  creds     Json?              // AuthenticationCreds serializado
  keys      Json?              // Signal keys (pre-key, session, sender-key, etc.)
  updatedAt DateTime @updatedAt

  @@map("whatsapp_sessions")
}

model OrderNotification {
  id         String   @id @default(cuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  channel    String   // "WHATSAPP" | "EMAIL"
  recipient  String?  // número ou email usado no envio
  eventText  String?  // texto do lastTracking no momento do envio
  sentAt     DateTime @default(now())
  eventHash  String   // hash do lastTracking para deduplicação
  success    Boolean
  error      String?

  @@unique([orderId, eventHash])
  @@map("order_notifications")
}

enum UserRole {
  ADMIN
  VIEWER
}

enum OrderStatus {
  PENDING
  IN_TRANSIT
  DELIVERED
  CANCELLED
}

enum TrackingSystem {
  SSW
  SENIOR
  PUPPETEER
  SAO_MIGUEL
  ATUAL_CARGAS
  RODONAVES
  BRASPRESS
  NONE
}
