generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Carrier {
  id                 String         @id @default(cuid())
  name               String
  cnpj               String         @unique
  phone              String
  active             Boolean        @default(true)
  trackingSystem     TrackingSystem @default(NONE)
  trackingIdentifier String?
  whatsappResponsavel String?       // WhatsApp do responsável na transportadora (avisos de ocorrência/atraso)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  orders             Order[]

  @@map("carriers")
}

model Order {
  id                String        @id @default(cuid())
  orderNumber       String        @unique
  customerName      String
  customerEmail     String?
  customerPhone     String?
  carrierId         String?
  carrier           Carrier?      @relation(fields: [carrierId], references: [id])
  status            OrderStatus   @default(PENDING)
  shippedAt         DateTime?
  estimatedDelivery DateTime?
  deliveredAt       DateTime?
  notes             String?
  nfNumber          String?
  nfValue           Float?
  nfIssuedAt        DateTime?
  senderCnpj        String?
  recipientCnpj     String?
  lastTracking      String?
  lastTrackingAt    DateTime?
  trackingEvents    Json?
  hasOccurrence     Boolean   @default(false)
  linkDanfe         String?       // URL do DANFE no Bling (para envio na notificação FATURADO)
  nfKey             String?       // chave de acesso da NF-e (44 dígitos) — usada no rastreio Modular
  // Mercado Envios 1: o ML exige que o VENDEDOR informe shipped/delivered (sujeito a
  // penalidade). Ligação: numeroLoja do pedido Bling = order/pack id do ML.
  mlCompany             String?    // avic | agro — conta ML dona da venda
  mlOrderId             String?    // order (ou pack) id do ML
  mlShipmentId          String?    // shipment ME1 notificado
  mlSemEnvio            Boolean    @default(false) // venda "a combinar" (sem envio no ML):
                                   // a entrega é informada pelo feedback do pedido (fulfilled)
  mlShippedNotifiedAt   DateTime?  // quando avisamos "a caminho" (idempotência)
  mlOutForDeliveryAt    DateTime?  // quando avisamos "saiu para entrega" (substatus out_for_delivery)
  mlPromessaEntrega     DateTime?  // prazo prometido pelo ML ao comprador (métrica de atraso do ML)
  mlDeliveredNotifiedAt DateTime?  // quando avisamos "entregue" (irreversível no ML)
  mlEnvioErro           String?    // último erro de notificação, p/ diagnóstico
  mlVinculoTentadoAt    DateTime?  // última tentativa de casar com uma venda ML
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  statusHistory     StatusHistory[]
  notifications     OrderNotification[]
  pendencias        Pendencia[]

  @@index([status])
  @@index([nfNumber])
  @@index([estimatedDelivery, status])
  @@index([mlShipmentId])
  @@map("orders")
}

model StatusHistory {
  id        String      @id @default(cuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    OrderStatus
  note      String?
  createdAt DateTime    @default(now())

  @@map("status_history")
}

model BlingToken {
  id           String   @id @default(cuid())
  companyKey   String   @unique
  accessToken  String
  refreshToken String
  updatedAt    DateTime @updatedAt

  @@map("bling_tokens")
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      UserRole @default(VIEWER)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model WhatsappSession {
  company   String   @id      // "avic" | "agro"
  files     String            // JSON.stringify({ filename: content }) — cópia exata dos arquivos do Baileys
  updatedAt DateTime @updatedAt

  @@map("whatsapp_sessions")
}

model OrderNotification {
  id         String   @id @default(cuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  channel    String   // "WHATSAPP" | "EMAIL"
  recipient  String?  // número ou email usado no envio
  eventText  String?  // texto do lastTracking no momento do envio
  sentAt     DateTime @default(now())
  eventHash  String   // hash do lastTracking para deduplicação
  success    Boolean
  error      String?

  @@unique([orderId, eventHash])
  @@map("order_notifications")
}

// ============================================================
// Módulo de Separação por bipe (ver PLANO-SEPARACAO.md)
// Isolado do restante: tabelas com prefixo separacao_, sem FK para Order.
// ============================================================

model SeparacaoOperador {
  id         String   @id @default(cuid())
  nome       String   @unique
  pinHash    String
  supervisor Boolean  @default(false) // pode triar, finalizar, liberar exceções e gerir operadores
  ativo      Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tarefasOperadas    SeparacaoTarefa[] @relation("TarefaOperador")
  tarefasTriadas     SeparacaoTarefa[] @relation("TarefaTriador")
  tarefasFinalizadas SeparacaoTarefa[] @relation("TarefaFinalizador")
  eventos            SeparacaoEvento[]

  @@map("separacao_operadores")
}

model SeparacaoTarefa {
  id              String          @id @default(cuid())
  companyKey      String          // avic | agrogranja | equipage
  blingNfId       String          // id da NF no Bling
  nfNumero        String
  nfSerie         String?
  chaveAcesso     String?         // 44 dígitos — é o que o leitor lê no código de barras da DANFE
  nfEmitidaEm     DateTime?
  clienteNome     String
  canal           String?         // loja/canal de venda, quando o Bling expõe
  valorNota       Float?
  orderId         String?         // id em orders, quando o order-tracker também tiver a NF (sem FK: módulo isolado)
  status          SeparacaoStatus @default(AGUARDANDO_TRIAGEM)
  itensCarregados Boolean         @default(false)
  observacao      String?

  triadoPorId     String?
  triadoPor       SeparacaoOperador? @relation("TarefaTriador", fields: [triadoPorId], references: [id])
  triadoEm        DateTime?
  operadorId      String?
  operador        SeparacaoOperador? @relation("TarefaOperador", fields: [operadorId], references: [id])
  iniciadoEm      DateTime?
  separadoEm      DateTime?
  finalizadoPorId String?
  finalizadoPor   SeparacaoOperador? @relation("TarefaFinalizador", fields: [finalizadoPorId], references: [id])
  concluidoEm     DateTime?

  // Conferência de peso no balcão (fase 4b — aguarda balança)
  pesoConferido   Boolean         @default(false)
  pesoCaixaLido   Float?          // kg — peso da caixa fechada, quando pesada

  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  itens   SeparacaoItem[]
  eventos SeparacaoEvento[]

  @@unique([companyKey, blingNfId])
  @@index([status])
  @@index([companyKey, nfNumero])
  @@index([chaveAcesso])
  @@index([nfEmitidaEm])
  @@map("separacao_tarefas")
}

model SeparacaoItem {
  id             String          @id @default(cuid())
  tarefaId       String
  tarefa         SeparacaoTarefa @relation(fields: [tarefaId], references: [id], onDelete: Cascade)
  ordem          Int
  sku            String
  nome           String
  fotoUrl        String?
  blingProdutoId String?
  origemKit      String?         // ex.: "KIT-123 ×2" — de qual kit da NF este item físico veio
  qtdEsperada    Float
  qtdBipada      Float           @default(0)
  qtdManual      Boolean         @default(false) // quantidade digitada (não bipada unidade a unidade) → conferir peso
  pesoUnit       Float?          // kg, do cadastro do Bling
  pesoLido       Float?          // kg, lido na balança do balcão
  pesoOk         Boolean?        // resultado da conferência de peso
  concluidoEm    DateTime?

  eventos SeparacaoEvento[]

  @@index([tarefaId, sku])
  @@map("separacao_itens")
}

model SeparacaoEvento {
  id         String              @id @default(cuid())
  tarefaId   String
  tarefa     SeparacaoTarefa     @relation(fields: [tarefaId], references: [id], onDelete: Cascade)
  operadorId String?
  operador   SeparacaoOperador?  @relation(fields: [operadorId], references: [id])
  itemId     String?
  item       SeparacaoItem?      @relation(fields: [itemId], references: [id], onDelete: SetNull)
  sku        String?
  tipo       SeparacaoEventoTipo
  qtd        Float?
  detalhe    String?
  criadoEm   DateTime            @default(now())

  @@index([tarefaId, criadoEm])
  @@index([tipo, criadoEm])
  @@map("separacao_eventos")
}

model SeparacaoConfig {
  chave     String   @id
  valor     String
  updatedAt DateTime @updatedAt

  @@map("separacao_config")
}

// Etiquetas QR de prateleira já impressas — para a tela "Pendentes do dia" mostrar só SKUs novos
model SeparacaoEtiqueta {
  id           String   @id @default(cuid())
  companyKey   String
  sku          String
  impressoEm   DateTime @default(now())
  impressoPorId String?

  @@unique([companyKey, sku])
  @@map("separacao_etiquetas")
}

enum SeparacaoStatus {
  AGUARDANDO_TRIAGEM
  PENDENTE
  IGNORADA
  EM_SEPARACAO
  SEPARADO
  CONCLUIDO
  CANCELADA
}

enum SeparacaoEventoTipo {
  TRIAGEM
  INICIO
  BIPE_OK
  BIPE_ERRADO
  BIPE_EXCEDENTE
  QTD_MANUAL
  PESO_OK
  PESO_FORA
  LIBERACAO
  SEPARADO
  FINALIZADO
  CANCELADO
  REABERTO
}

// Pendência de pós-venda: problema com uma venda (atraso, extravio, defeito, reclamação ML...)
model Pendencia {
  id           String           @id @default(cuid())
  orderId      String?
  order        Order?           @relation(fields: [orderId], references: [id])
  nfNumber     String?          // NF digitada (quando não há pedido vinculado)
  customerName String
  senderCnpj   String?          // empresa (AVIC/AGRO/EQUI)
  tipo         PendenciaTipo
  origem       PendenciaOrigem
  status       PendenciaStatus  @default(ABERTA)
  responsavel  String?          // quem está tratando (José, Micheli, Jeovan)
  descricao    String?
  mlClaimId    String?          @unique // id da reclamação no Mercado Livre (dedup)
  mlOrderId    String?          // id da venda no ML
  mlDueDate    DateTime?        // prazo máximo para responder ao ML
  resolvedAt   DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  notas        PendenciaNota[]

  @@index([status])
  @@index([senderCnpj, status])
  @@map("pendencias")
}

// Anotação com data no histórico de uma pendência
model PendenciaNota {
  id          String    @id @default(cuid())
  pendenciaId String
  pendencia   Pendencia @relation(fields: [pendenciaId], references: [id], onDelete: Cascade)
  texto       String
  autor       String?   // nome do usuário que anotou
  createdAt   DateTime  @default(now())

  @@map("pendencia_notas")
}

// Tokens OAuth do Mercado Livre por empresa (avic/agro) — chain própria do order-tracker
// Conversas do pós-venda ML aguardando resposta do vendedor (última mensagem é do
// comprador). Alimentada por varredura de pedidos recentes + checagem periódica.
model MlConversaPendente {
  packId     String    @id
  company    String    // AVIC | AGRO
  comprador  String
  item       String?
  naoLidas   Int       @default(1)  // msgs do comprador sem resposta no fim da conversa
  mensagens  Json?     // últimas mensagens p/ exibição no painel
  ultimaEm   DateTime?
  respondida Boolean   @default(false)
  updatedAt  DateTime  @updatedAt

  @@index([respondida])
  @@map("ml_conversas_pendentes")
}

model MlToken {
  companyKey   String   @id // "avic" | "agro"
  accessToken  String
  refreshToken String
  userId       String   // seller id no ML
  expiresAt    DateTime
  updatedAt    DateTime @updatedAt

  @@map("ml_tokens")
}

enum PendenciaTipo {
  ATRASO
  OCORRENCIA
  DEFEITO
  ITEM_FALTANTE
  DEVOLUCAO
  RECLAMACAO_ML
  OUTRO
}

enum PendenciaOrigem {
  AUTO          // criada pelo rastreamento (ocorrência/atraso)
  MANUAL
  MERCADO_LIVRE
}

enum PendenciaStatus {
  ABERTA
  EM_TRATAMENTO
  RESOLVIDA
}

enum UserRole {
  ADMIN
  VIEWER
}

enum OrderStatus {
  PENDING
  IN_TRANSIT
  DELIVERED
  CANCELLED
}

enum TrackingSystem {
  SSW
  SENIOR
  PUPPETEER
  SAO_MIGUEL
  ATUAL_CARGAS
  RODONAVES
  BRASPRESS
  MODULAR
  NONE
}

// Caixa de entrada das notificações do Mercado Livre para o cmvsync.
// O cmvsync roda no PC do José (sem URL pública), então o ML entrega aqui e ele busca de
// poucos em poucos segundos. Se o PC estiver desligado, a notificação espera nesta tabela.
model MlNotificacao {
  id         String   @id @default(cuid())
  topic      String
  resource   String
  mlUserId   String?
  recebidoEm DateTime @default(now())
  entregueEm DateTime?
  payload    Json?

  @@index([entregueEm, recebidoEm])
  @@map("ml_notificacoes")
}

// ---------------------------------------------------------------------------
// Monitor de DIFAL
//
// Nossos produtos de NCM 8436 têm a redução do Convênio ICMS 52/91: carga total
// de 5,6%, sendo 4,1% já recolhidos na origem (RS), restando 1,5% de DIFAL para
// o estado de destino. Quem paga esse 1,5% depende do canal e do destinatário:
//   - venda no ML para quem não tem IE  -> o ML paga e cobra de nós (lançamento CDIFAL)
//   - balcão ou Loja Integrada, sem IE  -> nós emitimos e pagamos a guia
//   - destinatário com IE (contribuinte) -> o DIFAL é dele, não nosso
// ---------------------------------------------------------------------------

// Uma nota fiscal de saída, com o DIFAL calculado e o confronto com o que o ML
// cobrou e com o que foi pago em guia.
model DifalNota {
  id              String   @id @default(cuid())
  empresa         String   // AVIC | AGRO
  nfNumero        String
  nfSerie         String?
  nfChave         String?  @unique
  blingId         String?  // id da NF no Bling, para reconsultar
  emitidaEm       DateTime
  naturezaOperacao String?

  // destinatário — só o necessário para o cálculo (LGPD: sem CPF, sem endereço completo)
  clienteNome     String
  clienteUf       String   // UF que define a alíquota de destino
  clienteTemIe    Boolean  @default(false) // com IE = contribuinte = DIFAL é dele
  clienteIe       String?

  // valores da nota
  valorProdutos   Float
  valorFrete      Float    @default(0)
  valorNota       Float
  valorComReducao Float    @default(0) // parcela dos itens com NCM 8436
  valorSemReducao Float    @default(0) // demais itens

  // canal de venda, que define quem paga
  canalId         String?  // id da loja no Bling (0 = balcão)
  canalNome       String?
  canalTipo       String?  // MercadoLivre | LojaIntegrada | Api | ...
  mlOrderId       String?  // para casar com a cobrança do ML
  // tipo de envio da venda do ML (FULL, Coleta, A combinar, ME1, Agência, Flex), lido uma vez da API do ML
  mlLogistica     String?
  // rastreio do Mercado Envios (vendas por Coleta, Agência, FULL, Flex), lido de /shipments/{id} do ML
  mlEnvioId        String?
  mlEnvioStatus    String?   // ready_to_ship | shipped | delivered | not_delivered | cancelled ...
  mlEnvioSubstatus String?   // ex.: out_for_delivery
  mlPrevisao       DateTime?
  mlEnvioLidoEm    DateTime?
  mlPackId        String?

  // o que calculamos
  difalCalculado  Float    @default(0)
  difalMetodo     String?  // carga | prop | sem_reducao | isento
  calculoDetalhe  Json?    // a conta aberta, para a contabilidade conferir
  // itens da NF como vieram do Bling: [{ sku, descricao, ncm, quantidade, unidade, valorUnitario, valorTotal }]
  itens           Json?

  // o que o ML cobrou de nós (lançamento CDIFAL do faturamento)
  difalCobradoMl  Float?
  cobradoMlEm     DateTime?

  // o que foi recolhido em guia
  difalPagoGuia   Float?
  guiaPagaEm      DateTime?

  responsavel     DifalResponsavel @default(NOSSO)
  situacao        DifalSituacao    @default(PENDENTE)
  divergencia     Float?           // diferença entre o calculado e o cobrado/pago
  observacao      String?

  // O que a guia (GNRE) exige do destinatário, lido do XML da nota:
  // código IBGE do município com 5 dígitos (sem a UF) e o CPF/CNPJ.
  // O documento fica aqui só para montar a guia — nunca vai para tela nem para log.
  municipioIbgeDestino  String?
  documentoDestinatario String?

  // rastro da guia gerada a partir desta nota
  guiaGeradaEm    DateTime?
  guiaLoteId      String?   // identificador do lote GNRE em que a guia saiu
  // venda do ML em que nós pagamos a guia e o José anexou o comprovante na venda do ML
  comprovanteMlEnviadoEm DateTime?

  criadoEm        DateTime @default(now())
  atualizadoEm    DateTime @updatedAt

  @@unique([empresa, nfNumero])
  @@index([emitidaEm])
  @@index([responsavel, situacao])
  @@index([clienteUf])
  @@index([mlOrderId])
  @@map("difal_notas")
}

// Alíquota interna e método de cálculo de cada estado. Fica em tabela, e não no
// código, porque muda por ato do fisco e a contabilidade precisa poder ajustar.
model DifalAliquota {
  uf              String   @id   // sigla do estado de destino
  nome            String
  aliquotaInterna Float          // alíquota interna cheia, sem fundo de pobreza
  fcp             Float    @default(0) // fundo de combate à pobreza, quando houver
  interestadual   Float    @default(7) // alíquota do RS para este estado: 7 ou 12
  metodo          String   @default("carga") // carga | prop
  posicaoFisco    Boolean  @default(false)   // true = há posição do fisco; false = regra geral
  nota            String?

  // O que as guias já pagas provam sobre este estado. Vale mais que a teoria:
  // é o que o fisco de fato aceitou. Alimentado pelas guias de DIFAL auditadas.
  guiasComReducao Int?     // guias em que a redução do Convênio 52/91 foi aplicada
  guiasTotal      Int?     // guias auditadas deste estado
  metodoObservado String?  // método que as guias mostram (pode diferir do configurado)
  evidenciaEm     DateTime?

  // Parâmetros da GNRE desta UF. O código da receita não é fixo em lei: cada
  // estado publica o seu no serviço GnreConfigUF, e é de lá que deve vir.
  codigoReceitaGnre  String?
  tipoDocOrigemGnre  String  @default("10")     // 10 = NF-e, conforme o manual
  // quando a guia vence: "saida" = antes de a mercadoria sair (por operação);
  // "dia15" = até o dia 15 do mês seguinte (quando a UF admite apuração)
  vencimentoRegra    String  @default("saida")
  // campos extras OBRIGATÓRIOS da receita nesta UF (GnreConfigUF), já classificados:
  // [{ codigo, titulo, conteudo: "chaveNfe" | "dataEmissao" | "observacao" | "desconhecido" }]
  camposExtrasGnre   Json?

  atualizadoEm    DateTime @updatedAt

  @@map("difal_aliquotas")
}

// Dados do emitente que entram na GNRE, por empresa. Vêm do bloco <emit> do XML
// das nossas próprias notas, então não precisam de cadastro à mão.
model DifalEmitente {
  empresa        String   @id    // AVIC | AGRO
  cnpj           String
  inscricaoEstadual String?
  razaoSocial    String
  endereco       String
  municipioIbge  String          // 5 dígitos, sem a UF
  uf             String
  cep            String
  telefone       String?
  atualizadoEm   DateTime @updatedAt

  @@map("difal_emitentes")
}

// Quem é o responsável pelo recolhimento do DIFAL daquela nota.
enum DifalResponsavel {
  ML_PAGA      // venda no Mercado Livre: o ML recolhe e cobra de nós depois
  NOSSO        // balcão, Loja Integrada: a guia é nossa
  CLIENTE      // destinatário contribuinte, com inscrição estadual
  SEM_DIFAL    // venda dentro do RS ou operação sem diferencial
}

enum DifalSituacao {
  PENDENTE     // calculado, aguardando guia ou cobrança do ML
  CONFERIDO    // o que cobraram bate com o que calculamos
  DIVERGENTE   // o ML cobrou diferente do calculado
  PAGO         // guia recolhida
  ATRASADO     // passou do prazo sem guia
}

// Lançamentos CDIFAL da fatura do Mercado Livre (o que ele cobra de nós pelo DIFAL que
// recolheu). O ML não informa pedido nem envio nesses lançamentos, então o fechamento é
// por mês e por empresa — nunca nota a nota.
model DifalCobrancaMl {
  id        String   @id      // "EMPRESA:detail_id"
  empresa   String            // AVIC | AGRO
  periodo   String            // chave do período da fatura, ex.: 2026-11-01
  data      DateTime          // data do lançamento
  natureza  String            // CHARGE (cobrou) | BONUS (estornou)
  valor     Float             // já vem negativo no estorno
  criadoEm  DateTime @default(now())

  @@index([empresa, periodo])
  @@map("difal_cobrancas_ml")
}

// Lote GNRE montado a partir das notas (guiaLoteId das difal_notas aponta para cá).
// Guarda o XML enviado e o que o portal respondeu: recibo, situação, resultado e o PDF
// das guias em base64. Gerar/enviar lote NÃO paga nada — o pagamento continua no banco.
model DifalLoteGnre {
  id                String    @id        // EMPRESA-AAAAMMDDHHMMSS
  empresa           String
  ambiente          String               // homologacao | producao (de onde saiu/para onde foi)
  xml               String
  guias             Int
  total             Float
  criadoEm          DateTime  @default(now())
  enviadoEm         DateTime?
  numeroRecibo      String?
  situacaoCodigo    String?              // última situação devolvida pelo portal
  situacaoDescricao String?
  consultadoEm      DateTime?
  resultadoXml      String?
  pdfGuias          String?              // base64

  @@index([empresa, criadoEm])
  @@map("difal_lotes_gnre")
}
